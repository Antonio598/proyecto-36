// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  RECEPTIONIST
  PROFESSIONAL
  SUPERADMIN
}

// New statuses WAITING, IN_CONSULTATION, ATTENDED, NO_SHOW are added via SQL in Supabase Studio.
// Once added to the DB enum, add them here too and re-run prisma generate.
enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  role         Role          @default(RECEPTIONIST)
  appointments Appointment[] @relation("ProfessionalAppointments")
  accountId    String?
  account      Account?      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Patient {
  id               String               @id @default(uuid())
  fullName         String
  phone            String
  cedula_pasaporte String?
  edad             Int?
  email            String?
  notes            String?
  appointments     Appointment[]
  contactLogs      ContactLog[]
  consultations    ConsultationRecord[]
  prescriptions    Prescription[]
  medicalFiles     MedicalFile[]
  background       PatientBackground[]
  videoSessions    VideoSession[]
  accountId        String?
  account          Account?             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([phone, accountId])
}

model Service {
  id                String                 @id @default(uuid())
  name              String
  durationMinutes   Int
  price             Float
  colorCode         String                 @default("#3b82f6")
  isActive          Boolean                @default(true)
  subaccountId      String?
  subaccount        Subaccount?            @relation(fields: [subaccountId], references: [id], onDelete: SetNull)
  availabilityRules AvailabilityRule[]
  appointments      Appointment[]
  configurations    ServiceConfiguration[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
}

model Product {
  id        String   @id @default(uuid())
  name      String
  price     Float
  stock     Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AvailabilityRule {
  id           String      @id @default(uuid())
  serviceId    String?
  service      Service?    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  subaccountId String?
  subaccount   Subaccount? @relation(fields: [subaccountId], references: [id], onDelete: Cascade)
  calendarId   String?
  calendar     Calendar?   @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  dayOfWeek    Int
  startTime    String
  endTime      String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Appointment {
  id                      String            @id @default(uuid())
  patientId               String?
  patient                 Patient?          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  serviceId               String?
  service                 Service?          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  professionalId          String?
  professional            User?             @relation("ProfessionalAppointments", fields: [professionalId], references: [id], onDelete: SetNull)
  subaccountId            String?
  subaccount              Subaccount?       @relation(fields: [subaccountId], references: [id], onDelete: Cascade)
  doctorId                String?
  doctor                  Doctor?           @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  calendarId              String?
  calendar                Calendar?         @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  status                  AppointmentStatus @default(PENDING)
  paymentStatus           String            @default("PENDING")
  stripePaymentIntentId   String?
  stripeCheckoutSessionId String?
  paidAt                  DateTime?
  startTime               DateTime
  endTime                 DateTime
  isBlocker               Boolean           @default(false)
  notes                   String?
  totalPrice              Float?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  reminders               ReminderLog[]
  consultationRecord      ConsultationRecord?
  transaction             Transaction?
  videoRoom               VideoRoom?
}

model ReminderLog {
  id             String      @id @default(uuid())
  appointmentId  String
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  reminderNumber Int
  sentAt         DateTime    @default(now())

  @@unique([appointmentId, reminderNumber])
}

model Subaccount {
  id                String                 @id @default(uuid())
  name              String
  videoUrl          String?
  doctors           Doctor[]
  services          Service[]
  calendars         Calendar[]
  appointments      Appointment[]
  configurations    ServiceConfiguration[]
  availabilityRules AvailabilityRule[]
  consultations     ConsultationRecord[]
  prescriptions     Prescription[]
  medicalFiles      MedicalFile[]
  background        PatientBackground[]
  transactions      Transaction[]
  videoSessions     VideoSession[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  accountId         String?
  account           Account?               @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Account {
  id             String         @id @default(uuid())
  name           String
  apiKey         String         @unique @default(uuid())
  maxSubaccounts Int?
  maxDoctors     Int?
  has_directory  Boolean        @default(false)
  has_agent      Boolean        @default(false)
  has_calendar   Boolean        @default(true)
  has_ehr        Boolean        @default(false)
  subaccounts    Subaccount[]
  users          User[]
  patients       Patient[]
  contactLogs    ContactLog[]
  transactions   Transaction[]
  videoSessions  VideoSession[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Doctor {
  id            String                 @id @default(uuid())
  name          String
  subaccountId  String
  specialty     String?
  bio           String?
  phone         String?
  email         String?
  photoUrl      String?
  location      String?
  socialLinks   Json?
  insurances    Json?
  isPublic      Boolean                @default(false)
  subaccount    Subaccount             @relation(fields: [subaccountId], references: [id], onDelete: Cascade)
  calendars     Calendar[]
  services      ServiceConfiguration[]
  appointments  Appointment[]
  consultations ConsultationRecord[]
  prescriptions Prescription[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
}

model Calendar {
  id                String                 @id @default(uuid())
  name              String
  subaccountId      String
  subaccount        Subaccount             @relation(fields: [subaccountId], references: [id], onDelete: Cascade)
  doctorId          String
  doctor            Doctor                 @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  configurations    ServiceConfiguration[]
  appointments      Appointment[]
  availabilityRules AvailabilityRule[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
}

model ContactLog {
  id              String    @id @default(uuid())
  patientId       String
  patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  accountId       String
  account         Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactedAt     DateTime
  isActive        Boolean   @default(true)
  followUp1SentAt DateTime?
  followUp2SentAt DateTime?
  followUp3SentAt DateTime?
  createdAt       DateTime  @default(now())
}

model ServiceConfiguration {
  id              String     @id @default(uuid())
  serviceId       String
  service         Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  calendarId      String
  calendar        Calendar   @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  doctorId        String
  doctor          Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  subaccountId    String
  subaccount      Subaccount @relation(fields: [subaccountId], references: [id], onDelete: Cascade)
  price           Float
  durationMinutes Int
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([serviceId, calendarId])
}

// ─── EHR: Antecedentes del paciente (por tenant) ──────────────────────────────
model PatientBackground {
  id                 String     @id @default(uuid())
  patientId          String
  patient            Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  subaccountId       String
  subaccount         Subaccount @relation(fields: [subaccountId], references: [id], onDelete: Cascade)
  bloodType          String?
  allergies          String?
  chronicConditions  String?
  surgicalHistory    String?
  familyHistory      String?
  currentMedications String?
  updatedAt          DateTime   @updatedAt
  createdAt          DateTime   @default(now())

  @@unique([patientId, subaccountId])
}

// ─── EHR: Registro de consulta (visita clínica) ───────────────────────────────
model ConsultationRecord {
  id             String       @id @default(uuid())
  appointmentId  String?      @unique
  appointment    Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  subaccountId   String
  subaccount     Subaccount   @relation(fields: [subaccountId], references: [id], onDelete: Cascade)
  doctorId       String?
  doctor         Doctor?      @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  visitDate      DateTime     @default(now())
  chiefComplaint String?
  diagnosis      String?
  observations   String?
  treatmentPlan  String?
  isVirtual      Boolean        @default(false)
  prescriptions  Prescription[]
  medicalFiles   MedicalFile[]
  videoSession   VideoSession?
  updatedAt      DateTime       @updatedAt
  createdAt      DateTime       @default(now())
}

// ─── EHR: Recetas médicas ──────────────────────────────────────────────────────
model Prescription {
  id                   String              @id @default(uuid())
  consultationRecordId String?
  consultationRecord   ConsultationRecord? @relation(fields: [consultationRecordId], references: [id], onDelete: SetNull)
  patientId            String
  patient              Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  subaccountId         String
  subaccount           Subaccount          @relation(fields: [subaccountId], references: [id], onDelete: Cascade)
  doctorId             String?
  doctor               Doctor?             @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  medications          Json                @default("[]")
  notes                String?
  issuedAt             DateTime            @default(now())
  createdAt            DateTime            @default(now())
}

// ─── EHR: Archivos clínicos (Supabase Storage) ────────────────────────────────
model MedicalFile {
  id                   String              @id @default(uuid())
  consultationRecordId String?
  consultationRecord   ConsultationRecord? @relation(fields: [consultationRecordId], references: [id], onDelete: SetNull)
  patientId            String
  patient              Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  subaccountId         String
  subaccount           Subaccount          @relation(fields: [subaccountId], references: [id], onDelete: Cascade)
  fileName             String
  fileUrl              String
  fileType             String              @default("document")
  description          String?
  uploadedAt           DateTime            @default(now())
}

// ─── Finanzas: Transacciones ──────────────────────────────────────────────────
model Transaction {
  id                    String       @id @default(uuid())
  accountId             String
  account               Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  subaccountId          String?
  subaccount            Subaccount?  @relation(fields: [subaccountId], references: [id], onDelete: SetNull)
  appointmentId         String?      @unique
  appointment           Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  amount                Float
  currency              String       @default("USD")
  type                  String       @default("APPOINTMENT")
  status                String       @default("PENDING")
  stripePaymentIntentId String?
  description           String?
  transactionDate       DateTime     @default(now())
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
}

// ─── Teleconsulta: Salas de video (Daily.co) ──────────────────────────────────
model VideoRoom {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  dailyRoomName String      @unique
  dailyRoomUrl  String
  patientToken  String?
  doctorToken   String?
  status        String      @default("WAITING")
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime    @default(now())
}

// ─── Teleconsulta: Registro de sesiones de video ──────────────────────────────
model VideoSession {
  id             String              @id @default(uuid())
  accountId      String
  account        Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  subaccountId   String?
  subaccount     Subaccount?         @relation(fields: [subaccountId], references: [id], onDelete: SetNull)
  patientId      String?
  patient        Patient?            @relation(fields: [patientId], references: [id], onDelete: SetNull)
  consultationId String?             @unique
  consultation   ConsultationRecord? @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  appointmentId  String?
  roomUrl        String
  roomName       String
  status         String              @default("OPEN")
  startedAt      DateTime            @default(now())
  endedAt        DateTime?
  notes          String?
  amount         Float?
  paymentStatus  String              @default("PENDING")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}
